APP_ENV=demo
NEXT_PUBLIC_APP_MODE=demo
# Default: same-origin API. Optional build-time override for separate hosting.
NEXT_PUBLIC_API_ORIGIN=
# Optional: only needed when explicitly allowing a separate frontend origin.
WEB_ORIGIN=
PORT=4000
DATABASE_URL=postgresql://orionx:orionx_local_only@localhost:5432/orionx
# Session pooler (5432) or direct connection for Prisma schema commands.
# On Supabase, DATABASE_URL uses the transaction pooler (6543), pgbouncer=true,
# sslmode=require and a small connection_limit; DIRECT_URL uses the session pooler.
DIRECT_URL=postgresql://orionx:orionx_local_only@localhost:5432/orionx
REDIS_URL=redis://localhost:6379
WORKER_POLL_MS=3000
WORKER_LEASE_MS=120000
WORKER_MAX_ATTEMPTS=5
SOURCE_MODE=fixture
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Passport Skill Records
GOOGLE_SERVICE_ACCOUNT_JSON=
CHAIN_MODE=offline
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
SOLANA_EXPECTED_GENESIS_HASH=
SOLANA_ISSUER_KEYPAIR_PATH=
STORAGE_MODE=local
ARTIFACT_DIRECTORY=.artifacts
SUPABASE_URL=
# Preferred server-only API key (sb_secret_...). Never add NEXT_PUBLIC_ to it.
SUPABASE_SECRET_KEY=
# Legacy fallback only. Leave empty when SUPABASE_SECRET_KEY is configured.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=passport-pdfs
SUPABASE_JWKS_URL=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
# Optional HMAC signing key override for HTTP-only OAuth PKCE state cookies (defaults to SUPABASE_SECRET_KEY).
AUTH_COOKIE_SECRET=
# The three JWT settings above default to this project's Auth endpoint and
# audience "authenticated" when SUPABASE_URL is configured.

# Freeze this public origin into each reserved snapshot before rendering.
VERIFICATION_PUBLIC_ORIGIN=http://localhost:3000
TEMPLATE_REVISION=btu-reference-v1
ISSUER_TRUST_MODE=DEMO
# Enable source polling only when the intended source is configured.
SYNC_ENABLED=false
GOOGLE_SHEET_TAB_ID=
GOOGLE_DATA_RANGE=PassportRecords
# Local path or workload identity; alternative to GOOGLE_SERVICE_ACCOUNT_JSON.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_METADATA_ENROLLMENT_ENABLED=false
# Operator-only; never include the admin/upgrade keys in the worker or browser.
SOLANA_ADMIN_KEYPAIR_PATH=
# Optional future institutional trust material. Not needed for the simulated issuer.
BTU_TRUST_MANIFEST_PATH=
BTU_TRUST_ROOT_PUBLIC_KEY=
