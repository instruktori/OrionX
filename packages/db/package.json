{
  "name": "@orionx/db",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "generate": "node ../../scripts/with-env.mjs prisma generate --schema prisma/schema.prisma",
    "migrate": "node ../../scripts/with-env.mjs prisma migrate dev --schema prisma/schema.prisma",
    "validate": "node ../../scripts/with-env.mjs prisma validate --schema prisma/schema.prisma",
    "push": "node ../../scripts/with-env.mjs prisma db push --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0"
  }
}
